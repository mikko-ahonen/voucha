{:paths ["src" "resources"]

 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  com.github.seancorfield/next.jdbc {:mvn/version "1.3.955"}
  org.postgresql/postgresql {:mvn/version "42.7.4"}
  com.zaxxer/HikariCP {:mvn/version "5.1.0"}
  migratus/migratus {:mvn/version "1.5.6"}
  metosin/malli {:mvn/version "0.16.4"}
  org.clojure/data.json {:mvn/version "2.5.0"}
  com.github.javaparser/javaparser-core {:mvn/version "3.26.2"}
  org.slf4j/slf4j-simple {:mvn/version "2.0.13"}}

 :aliases
 ;; The embedded database is a development and test dependency. `voucha.dev` is
 ;; the only namespace that touches it, which is why it lives under dev/ rather
 ;; than src/: a production runtime never loads it.
 {:dev
  {:extra-paths ["dev" "target/classes"]
   :extra-deps {io.zonky.test/embedded-postgres {:mvn/version "2.0.7"}
                io.zonky.test.postgres/embedded-postgres-binaries-linux-amd64
                {:mvn/version "16.2.0"}}}

  :test
  {:extra-paths ["tests" "test-resources" "target/classes" "dev"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                io.zonky.test/embedded-postgres {:mvn/version "2.0.7"}
                io.zonky.test.postgres/embedded-postgres-binaries-linux-amd64
                {:mvn/version "16.2.0"}}
   :main-opts ["-m" "cognitect.test-runner" "-d" "tests"]
   :exec-fn cognitect.test-runner.api/test
   :exec-args {:dirs ["tests"]}}

  :build
  {:deps {io.github.clojure/tools.build {:mvn/version "0.10.5"}}
   :ns-default build}}}
